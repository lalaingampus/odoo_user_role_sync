<odoo>
    <record id="view_wizard_sync_user_roles_form" model="ir.ui.view">
        <field name="name">wizard.sync.user.roles.form</field>
        <field name="model">wizard.sync.user.roles</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Sinkronisasi Role Akses User dari Excel">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,preview,done" />
                </header>
                <sheet>
                    <!-- ========================================================= -->
                    <!-- STEP 1: UPLOAD FILE (STATE = DRAFT) -->
                    <!-- ========================================================= -->
                    <div invisible="state != 'draft'">
                        <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
                            <div>
                                <h5 class="alert-heading mb-1"><i class="fa fa-info-circle me-1" /> Langkah 1: Upload File Matriks Role</h5>
                                <p class="mb-0">
                                    Upload file Excel Anda. Sistem akan memindai data dan menampilkan <strong>Tabel Preview Pengecekan</strong> sebelum diterapkan ke database.
                                </p>
                            </div>
                            <div>
                                <button
                                    name="action_download_template"
                                    string="Download Excel Template"
                                    type="object"
                                    icon="fa-download"
                                    class="btn btn-outline-primary btn-sm"
                                />
                            </div>
                        </div>

                        <group>
                            <group string="File Matriks Excel">
                                <field name="file_excel" filename="filename" widget="binary" />
                                <field name="filename" invisible="1" />
                                <div class="mt-2 text-muted">
                                    <span>Download format template Excel dinamis: </span>
                                    <button
                                        name="action_download_template"
                                        string="Download Template Excel (.xlsx)"
                                        type="object"
                                        icon="fa-download"
                                        class="btn btn-link p-0 align-baseline"
                                    />
                                </div>
                            </group>
                            <group string="Pengaturan Sinkronisasi">
                                <field name="template_type" widget="radio" />
                                <field name="auto_create_role" />
                                <field name="default_role_prefix" placeholder="Contoh: Role -" />
                            </group>
                        </group>
                    </div>

                    <!-- ========================================================= -->
                    <!-- STEP 2: PREVIEW & VERIFIKASI (STATE = PREVIEW) -->
                    <!-- ========================================================= -->
                    <div invisible="state != 'preview'">
                        <div class="alert alert-info d-flex justify-content-between align-items-center mb-2 py-2 px-3 shadow-sm rounded" role="alert">
                            <div>
                                <h6 class="alert-heading mb-0 fw-bold text-dark">
                                    <i class="fa fa-check-square me-1 text-primary" /> Langkah 2: Pengecekan &amp; Pemilihan User
                                </h6>
                                <p class="mb-0 text-muted small">
                                    Centang atau pilih baris user yang ingin disinkronkan, lalu klik <strong>"Konfirmasi &amp; Terapkan Role"</strong>.
                                </p>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge rounded-pill bg-white text-dark border px-3 py-2 fw-bold shadow-sm" style="white-space: nowrap; font-size: 12px;">
                                    <i class="fa fa-list text-muted me-1" /> Total: <field name="total_rows" nolabel="1" class="fw-bold" />
                                </span>
                                <span class="badge rounded-pill bg-primary text-white px-3 py-2 fw-bold shadow-sm" style="white-space: nowrap; font-size: 12px;">
                                    <i class="fa fa-check-square me-1" /> Dipilih: <field name="selected_rows" nolabel="1" class="fw-bold" />
                                </span>
                                <span class="badge rounded-pill bg-success text-white px-3 py-2 fw-bold shadow-sm" style="white-space: nowrap; font-size: 12px;">
                                    <i class="fa fa-check-circle me-1" /> Cocok di Odoo: <field name="matched_rows" nolabel="1" class="fw-bold" />
                                </span>
                                <span class="badge rounded-pill bg-danger text-white px-3 py-2 fw-bold shadow-sm" style="white-space: nowrap; font-size: 12px;" invisible="missing_rows == 0">
                                    <i class="fa fa-exclamation-triangle me-1" /> Belum Terdaftar: <field name="missing_rows" nolabel="1" class="fw-bold" />
                                </span>
                            </div>
                        </div>

                        <!-- Quick Selection Toolbar -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="btn-group btn-group-sm">
                                <button name="action_select_all" string="Pilih Semua User Cocok" type="object" icon="fa-check-square-o" class="btn btn-outline-primary btn-sm" />
                                <button name="action_deselect_all" string="Batal Pilih Semua" type="object" icon="fa-square-o" class="btn btn-outline-secondary btn-sm" />
                            </div>
                            <span class="text-muted small">
                                <i class="fa fa-info-circle me-1"/>Tips: Anda dapat mengaktifkan/menonaktifkan baris yang ingin disinkronkan pada kolom <strong>Pilih / Sync</strong>.
                            </span>
                        </div>

                        <field name="line_ids">
                            <list editable="bottom" create="0" delete="0" decoration-success="user_status == 'matched' and is_selected" decoration-muted="not is_selected" decoration-danger="user_status == 'missing'">
                                <field name="is_selected" widget="boolean_toggle" string="Pilih / Sync" />
                                <field name="row_index" readonly="1" string="Baris" />
                                <field name="name_excel" readonly="1" string="Nama di Excel" />
                                <field name="login_excel" readonly="1" string="Login / Email" />
                                <field name="job_excel" readonly="1" string="Jabatan" />
                                <field name="user_id" readonly="1" string="User di Odoo" />
                                <field name="user_status" readonly="1" widget="badge" decoration-success="user_status == 'matched'" decoration-danger="user_status == 'missing'" string="Status Akun" />
                                <field name="role_names" readonly="1" string="Target Role Odoo" />
                                <field name="permissions_summary" readonly="1" string="Ringkasan Izin Modul" />
                                <field name="is_enabled" widget="boolean_toggle" string="Role Aktif" />
                            </list>
                        </field>
                    </div>

                    <!-- ========================================================= -->
                    <!-- STEP 3: HASIL SELESAI (STATE = DONE) -->
                    <!-- ========================================================= -->
                    <div invisible="state != 'done'">
                        <field name="result_summary" widget="html" nolabel="1" />
                    </div>
                </sheet>
                <footer>
                    <!-- Tombol Step 1 -->
                    <button
                        name="action_load_preview"
                        string="Muat &amp; Cek Preview Data"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_download_template"
                        string="Download Template Excel"
                        type="object"
                        icon="fa-download"
                        class="btn btn-secondary"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Batal"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'draft'"
                    />

                    <!-- Tombol Step 2 -->
                    <button
                        name="action_apply_sync"
                        string="Konfirmasi &amp; Terapkan Role"
                        type="object"
                        class="btn-success"
                        invisible="state != 'preview'"
                    />
                    <button
                        name="action_back_to_upload"
                        string="Upload File Ulang"
                        type="object"
                        icon="fa-arrow-left"
                        class="btn-secondary"
                        invisible="state != 'preview'"
                    />
                    <button
                        string="Batal"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'preview'"
                    />

                    <!-- Tombol Step 3 -->
                    <button
                        name="action_view_updated_users"
                        string="Lihat Data di Users (Tab User Roles)"
                        type="object"
                        class="btn-primary"
                        icon="fa-users"
                        invisible="state != 'done'"
                    />
                    <button
                        string="Tutup"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'done'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_sync_user_roles" model="ir.actions.act_window">
        <field name="name">Sync Roles from Excel</field>
        <field name="res_model">wizard.sync.user.roles</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_sync_user_roles_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_wizard_sync_user_roles"
        name="Sync Roles from Excel"
        parent="base.menu_users"
        action="action_wizard_sync_user_roles"
        sequence="60"
        groups="base.group_erp_manager"
    />
</odoo>
