<odoo>
    <record id="view_wizard_sync_user_roles_form" model="ir.ui.view">
        <field name="name">wizard.sync.user.roles.form</field>
        <field name="model">wizard.sync.user.roles</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Synchronize User Roles from Excel">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,preview,done" />
                </header>
                <sheet>
                    <!-- ========================================================= -->
                    <!-- STEP 1: UPLOAD FILE (STATE = DRAFT) -->
                    <!-- ========================================================= -->
                    <div invisible="state != 'draft'">
                        <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
                            <div>
                                <h5 class="alert-heading mb-1"><i class="fa fa-info-circle me-1" /> Step 1: Upload Role Matrix File</h5>
                                <p class="mb-0">
                                    Upload your Excel spreadsheet. The system will parse rows and display a <strong>Verification Preview Table</strong> before applying changes to the database.
                                </p>
                            </div>
                            <div>
                                <button
                                    name="action_download_template"
                                    string="Download Excel Template"
                                    type="object"
                                    icon="fa-download"
                                    class="btn btn-outline-primary btn-sm"
                                />
                            </div>
                        </div>

                        <group>
                            <group string="Excel Spreadsheet File">
                                <field name="file_excel" filename="filename" widget="binary" />
                                <field name="filename" invisible="1" />
                                <div class="mt-2 text-muted">
                                    <span>Download dynamic template format: </span>
                                    <button
                                        name="action_download_template"
                                        string="Download Excel Template (.xlsx)"
                                        type="object"
                                        icon="fa-download"
                                        class="btn btn-link p-0 align-baseline"
                                    />
                                </div>
                            </group>
                            <group string="Synchronization Options">
                                <field name="template_type" widget="radio" />
                                <field name="auto_create_role" />
                                <field name="auto_create_user" />
                                <field name="default_role_prefix" placeholder="e.g. Role -" />
                            </group>
                        </group>
                    </div>

                    <!-- ========================================================= -->
                    <!-- STEP 2: PREVIEW & VERIFICATION (STATE = PREVIEW) -->
                    <!-- ========================================================= -->
                    <div invisible="state != 'preview'">
                        <div class="alert alert-info d-flex justify-content-between align-items-center mb-3 py-2 px-3 shadow-sm rounded" role="alert">
                            <div>
                                <h6 class="alert-heading mb-0 fw-bold text-dark">
                                    <i class="fa fa-check-square me-1 text-primary" /> Step 2: Review &amp; User Selection
                                </h6>
                                <p class="mb-0 text-muted small">
                                    Select user rows to synchronize, then click <strong>"Confirm &amp; Apply Roles"</strong>.
                                </p>
                            </div>
                        </div>

                        <!-- Modern 4-Column Stat Summary Cards -->
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-3">
                                <div class="p-2 rounded border shadow-sm" style="background-color: #f8f9fa; border-color: #dee2e6 !important;">
                                    <div style="font-size: 11px; font-weight: 700; color: #495057; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <i class="fa fa-users me-1 text-secondary"/> Total Rows
                                    </div>
                                    <div style="font-size: 24px; font-weight: 800; color: #212529; line-height: 1.2; margin-top: 4px;">
                                        <field name="total_rows" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded border shadow-sm" style="background-color: #e7f1ff; border-color: #86b7fe !important; border-width: 2px !important;">
                                    <div style="font-size: 11px; font-weight: 700; color: #084298; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <i class="fa fa-check-square me-1 text-primary"/> Selected for Sync
                                    </div>
                                    <div style="font-size: 24px; font-weight: 800; color: #0d6efd; line-height: 1.2; margin-top: 4px;">
                                        <field name="selected_rows" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded border shadow-sm" style="background-color: #d1e7dd; border-color: #75b798 !important; border-width: 2px !important;">
                                    <div style="font-size: 11px; font-weight: 700; color: #0f5132; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <i class="fa fa-check-circle me-1 text-success"/> Ready to Process
                                    </div>
                                    <div style="font-size: 24px; font-weight: 800; color: #198754; line-height: 1.2; margin-top: 4px;">
                                        <field name="matched_rows" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded border shadow-sm" style="background-color: #f8d7da; border-color: #ea868f !important; border-width: 2px !important;">
                                    <div style="font-size: 11px; font-weight: 700; color: #842029; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <i class="fa fa-exclamation-triangle me-1 text-danger"/> Unregistered
                                    </div>
                                    <div style="font-size: 24px; font-weight: 800; color: #dc3545; line-height: 1.2; margin-top: 4px;">
                                        <field name="missing_rows" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Selection Toolbar -->
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <div class="btn-group btn-group-sm">
                                <button name="action_select_all" string="Select All Matched" type="object" icon="fa-check-square-o" class="btn btn-primary btn-sm fw-bold px-3" />
                                <button name="action_deselect_all" string="Deselect All" type="object" icon="fa-square-o" class="btn btn-outline-secondary btn-sm px-3" />
                            </div>
                            <span class="text-muted small">
                                <i class="fa fa-info-circle me-1 text-primary"/>Tip: You can manually select a user in the <strong>Matched User in Odoo</strong> column if names differ.
                            </span>
                        </div>

                        <field name="line_ids">
                            <tree editable="bottom" create="0" delete="0" decoration-success="user_status == 'matched' and is_selected" decoration-info="user_status == 'to_create'" decoration-muted="not is_selected" decoration-danger="user_status == 'missing'">
                                <field name="is_selected" widget="boolean_toggle" string="Select / Sync" />
                                <field name="row_index" readonly="1" string="Row" optional="show" />
                                <field name="name_excel" readonly="1" string="Name in Excel" />
                                <field name="login_excel" readonly="1" string="Login / Email" />
                                <field name="user_id" string="User in Odoo" />
                                <field name="user_status" readonly="1" widget="badge" decoration-success="user_status == 'matched'" decoration-info="user_status == 'to_create'" decoration-danger="user_status == 'missing'" string="Account Status" />
                                <field name="job_excel" readonly="1" string="Job / Dept" optional="show" />
                                <field name="role_names" readonly="1" string="Target Roles" />
                                <field name="permissions_summary" readonly="1" string="Module Permissions" optional="hide" />
                                <field name="is_enabled" widget="boolean_toggle" string="Active Role" />
                            </tree>
                        </field>
                    </div>

                    <!-- ========================================================= -->
                    <!-- STEP 3: RESULT SUMMARY (STATE = DONE) -->
                    <!-- ========================================================= -->
                    <div invisible="state != 'done'">
                        <field name="result_summary" widget="html" nolabel="1" />
                    </div>
                </sheet>
                <footer>
                    <!-- Step 1 Buttons -->
                    <button
                        name="action_load_preview"
                        string="Load &amp; Preview Data"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_download_template"
                        string="Download Excel Template"
                        type="object"
                        icon="fa-download"
                        class="btn btn-secondary"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'draft'"
                    />

                    <!-- Step 2 Buttons -->
                    <button
                        name="action_apply_sync"
                        string="Confirm &amp; Apply Roles"
                        type="object"
                        class="btn-success"
                        invisible="state != 'preview'"
                    />
                    <button
                        name="action_back_to_upload"
                        string="Re-upload File"
                        type="object"
                        icon="fa-arrow-left"
                        class="btn-secondary"
                        invisible="state != 'preview'"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'preview'"
                    />

                    <!-- Step 3 Buttons -->
                    <button
                        name="action_view_updated_users"
                        string="View Synchronized Users"
                        type="object"
                        class="btn-primary"
                        icon="fa-users"
                        invisible="state != 'done'"
                    />
                    <button
                        string="Close"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'done'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_sync_user_roles" model="ir.actions.act_window">
        <field name="name">Sync Roles from Excel</field>
        <field name="res_model">wizard.sync.user.roles</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_sync_user_roles_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_wizard_sync_user_roles"
        name="Sync Roles from Excel"
        parent="base.menu_users"
        action="action_wizard_sync_user_roles"
        sequence="60"
        groups="base.group_erp_manager"
    />
</odoo>
